<UserControl x:Class="Island.Modules.MediaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             >
    <Grid x:Name="RootGrid">
    <Grid.RowDefinitions>
        <RowDefinition Height="112"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid x:Name="MainGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Cover (Klick = Spotify öffnen) -->
        <Border x:Name="CoverBorder"
                Width="104" Height="104"
                VerticalAlignment="Center"
                CornerRadius="16"
                Background="{DynamicResource IslandPlaceholder}"
                Cursor="Hand"
                ToolTip="Spotify öffnen"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="CoverScale" ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>
            <TextBlock x:Name="CoverIcon"
                       Text="&#xE8D6;"
                       FontFamily="{StaticResource IconFont}"
                       FontSize="32"
                       Foreground="{DynamicResource IslandSubText}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>

        <Grid Grid.Column="1" Margin="16,3,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleText"
                           FontSize="15.5" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="TitleSlide"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
                <!-- Equalizer + "•••" (Quelle wechseln, Lyrics) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,-6,-6,-6">
                    <ContentControl x:Name="EqHost" Margin="0,0,4,0" VerticalAlignment="Center" Focusable="False"
                                    Cursor="Hand" ToolTip="Quelle wechseln &amp; Lyrics" Background="Transparent"/>
                    <Button x:Name="MoreBtn" Style="{StaticResource IconButton}" Content="&#xE712;"
                            Width="28" Height="28" FontSize="13" ToolTip="Quelle wechseln &amp; Lyrics"/>
                </StackPanel>
            </Grid>
            <TextBlock x:Name="ArtistText"
                       Grid.Row="1"
                       Margin="0,1,0,0"
                       FontSize="12.5"
                       Foreground="{DynamicResource IslandSubText}"
                       TextTrimming="CharacterEllipsis">
                <TextBlock.RenderTransform>
                    <TranslateTransform x:Name="ArtistSlide"/>
                </TextBlock.RenderTransform>
            </TextBlock>

            <!-- Fortschrittsbalken (klicken / ziehen = spulen) -->
            <!-- Fortschrittsbalken (Design wird im Code eingesetzt) -->
            <Grid x:Name="Track" Grid.Row="3" Height="20" Background="Transparent" Cursor="Hand" Margin="0,0,0,0"/>

            <Grid Grid.Row="4" Margin="0,-3,0,0">
                <TextBlock x:Name="PosText" Text="0:00" FontSize="10.5"
                           Foreground="{DynamicResource IslandSubText}" HorizontalAlignment="Left"/>
                <TextBlock x:Name="DurText" Text="0:00" FontSize="10.5"
                           Foreground="{DynamicResource IslandSubText}" HorizontalAlignment="Right"/>
            </Grid>

            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,-2">
                <Button x:Name="PrevBtn" Style="{StaticResource IconButton}" Content="&#xE892;" ToolTip="Letzter Song"/>
                <Button x:Name="PlayBtn" Style="{StaticResource IconButton}" Content="&#xE768;"
                        FontSize="21" Width="44" Height="38" Margin="12,0" ToolTip="Play / Pause"/>
                <Button x:Name="NextBtn" Style="{StaticResource IconButton}" Content="&#xE893;" ToolTip="Nächster Song"/>
            </StackPanel>
        </Grid>
    </Grid>

    <!-- Lyrics (optional) -->
    <Grid x:Name="LyricsPanel" Grid.Row="1" Height="50" Visibility="Collapsed" ClipToBounds="True" Margin="0,4,0,0">
        <StackPanel x:Name="LyricsStack" VerticalAlignment="Center">
            <StackPanel.RenderTransform>
                <TranslateTransform x:Name="LyricsSlide"/>
            </StackPanel.RenderTransform>
            <TextBlock x:Name="LyricNow" FontSize="15" FontWeight="SemiBold" TextAlignment="Center"
                       TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
            <TextBlock x:Name="LyricNext" FontSize="12" Margin="0,3,0,0" TextAlignment="Center"
                       TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"
                       Foreground="{DynamicResource IslandSubText}"/>
        </StackPanel>
    </Grid>

    <!-- Quelle wählen (über "•••") – wird im Code gefüllt -->
    <Grid x:Name="SourcePanel" Grid.RowSpan="2" Visibility="Collapsed" Opacity="0"/>
    </Grid>
</UserControl>
