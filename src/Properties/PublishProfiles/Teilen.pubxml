<?xml version="1.0" encoding="utf-8"?>
<!--
  "Teilen"-Version: EINE .exe, die auf jedem Windows 10/11 (64 Bit) sofort läuft –
  ohne .NET-Installation und ohne Befehle. Einfach doppelklicken.
  Bauen:  dotnet publish src\DynamicIsland.csproj -p:PublishProfile=Teilen
  Ergebnis: Ordner "Teilen\DynamicIsland.exe"
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>                                    <!-- .NET ist in der .exe drin -->
    <PublishSingleFile>true</PublishSingleFile>                            <!-- alles in einer Datei -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>    <!-- kleiner zum Verschicken -->
    <PublishDir>..\Teilen\</PublishDir>
  </PropertyGroup>
</Project>
