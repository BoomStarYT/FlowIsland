<Window x:Class="Island.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Island"
        Width="520" Height="340"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <!-- Kein Hintergrund = Klicks gehen durch den unsichtbaren Teil des Fensters durch -->
    <Grid x:Name="Root">
        <Grid x:Name="Pill"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Margin="18"
              Width="150" Height="36"
              TextElement.Foreground="{DynamicResource IslandText}">
            <Grid.LayoutTransform>
                <ScaleTransform x:Name="PillScale" ScaleX="1" ScaleY="1"/>
            </Grid.LayoutTransform>

            <!-- Schatten aus zwei halbdurchsichtigen Flächen: sieht fast gleich aus, kostet aber
                 viel weniger Leistung als ein echter Weichzeichner-Schatten -->
            <Grid x:Name="PillShadow" IsHitTestVisible="False">
                <Border x:Name="Shadow2" Margin="-5,2,-5,-8" CornerRadius="23" Background="#14000000"/>
                <Border x:Name="Shadow1" Margin="-2,1,-2,-4" CornerRadius="20" Background="#24000000"/>
            </Grid>

            <!-- Ebenen: Hintergrund, Glanz, Lichtkante -->
            <Border x:Name="PillBg" CornerRadius="18" Background="#FF0B0B0C"/>
            <Border x:Name="PillSheen" CornerRadius="18" Margin="1" IsHitTestVisible="False"/>
            <Border x:Name="PillRim" CornerRadius="18" BorderThickness="1" IsHitTestVisible="False"/>

            <!-- Inhalt hat eine FESTE Grösse und wird nur abgeschnitten, während die Insel wächst.
                 So muss WPF nicht bei jedem Animationsbild alles neu anordnen → flüssig. -->
            <Grid x:Name="ContentRoot" ClipToBounds="True">
                <!-- Zugeklappt -->
                <ContentControl x:Name="CompactHost"
                                Margin="6,0,12,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Focusable="False"/>

                <!-- Aufgeklappt -->
                <Grid x:Name="ExpandedRoot" Visibility="Collapsed" Opacity="0"
                      Margin="16,12,16,12"
                      Width="408" Height="148"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      RenderTransformOrigin="0.5,0">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="ExpandedScale" ScaleX="1" ScaleY="1"/>
                    </Grid.RenderTransform>

                    <Grid x:Name="TabContent">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ContentControl x:Name="ExpandedHost" Focusable="False">
                            <ContentControl.RenderTransform>
                                <TranslateTransform x:Name="ExpandedSlide"/>
                            </ContentControl.RenderTransform>
                        </ContentControl>
                        <StackPanel x:Name="TabBar"
                                    Grid.Row="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,8,0,0"/>
                    </Grid>

                    <!-- Doppelklick-Menü -->
                    <StackPanel x:Name="ActionsPanel"
                                Visibility="Collapsed" Opacity="0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
